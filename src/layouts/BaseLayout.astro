---
import '../styles/global.css';
import '../styles/theme.css';
import '../styles/site.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';
import { localePath, withBase } from '../data/site';

interface Props { title?: string; description?: string; locale: 'en' | 'zh'; path?: string; }
const { title, description, locale, path = '' } = Astro.props;
const ui = locale === 'zh' ? zh : en;
const nav = [
  { key: 'home', href: localePath(locale, 'blog') },
  { key: 'news', href: localePath(locale, 'news') },
  { key: 'projects', href: localePath(locale, 'projects') },
  { key: 'about', href: localePath(locale, 'about') },
];
const alternatePath = locale === 'en' ? localePath('zh', path) : localePath('en', path);
const pageTitle = title ? `${title} — ${ui.siteName}` : ui.siteName;

// SEO / social metadata.
// NOTE: `path` is the *counterpart* path (it is what the language switcher
// links to), so it must not be used to build this page's own canonical URL.
// `Astro.url.pathname` is the only reliable source for the current page.
const origin = Astro.site ?? new URL('https://joanna910225.github.io');
// Astro reports the site root as ".../feifeirong.github.io" without a trailing
// slash while every other route keeps one; normalise so canonicals match the
// hreflang URLs (and how the pages are actually served as directory indexes).
const rawPath = Astro.url.pathname;
const canonicalPath = rawPath.endsWith('/') ? rawPath : rawPath + '/';
const canonicalUrl = new URL(canonicalPath, origin).href;
const alternateUrl = new URL(alternatePath, origin).href;
const enUrl = locale === 'en' ? canonicalUrl : alternateUrl;
const zhUrl = locale === 'zh' ? canonicalUrl : alternateUrl;
const metaDescription = description ?? ui.siteTag;
const ogImage = new URL(withBase('og-cover.png'), origin).href;
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US';
const themeLabels = locale === 'zh'
  ? { toLight: '切换到浅色主题', toDark: '切换到深色主题' }
  : { toLight: 'Switch to light theme', toDark: 'Switch to dark theme' };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={ui.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${ui.siteName} — ${ui.siteTag}`} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <!--
      Resolve the theme before first paint to avoid a flash.
      Order of precedence: explicit visitor choice (localStorage) > OS
      preference > light. Light is the fallback when the OS preference is
      unavailable or reports neither value.
    -->
    <script is:inline>
      (function () {
        var theme = 'light';
        try {
          var saved = localStorage.getItem('site-theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
          else if (window.matchMedia) {
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
            else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
          }
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={localePath(locale)} aria-label={ui.siteName}><span class="brand-mark">&gt;_</span> {ui.siteName}</a>
        <nav aria-label="Main navigation">
          {nav.map((item) => <a href={item.href} class:list={{active: Astro.url.pathname === item.href || Astro.url.pathname === `${item.href}/` || Astro.url.pathname.startsWith(`${item.href}/`)}}>{ui.nav[item.key as keyof typeof ui.nav]}</a>)}
        </nav>
        <div class="header-tools">
          <LanguageSwitcher locale={locale} href={alternatePath} label={ui.language} />
          <button
            class="theme-toggle"
            type="button"
            aria-pressed="false"
            aria-label={themeLabels.toLight}
            title={themeLabels.toLight}
            data-label-light={themeLabels.toLight}
            data-label-dark={themeLabels.toDark}
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} Feifei Rong · <a class="text-link" href="mailto:feifei.rong2@gmail.com">feifei.rong2@gmail.com</a></span><span>{ui.footer.built}</span></footer>
    </div>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;

        function sync() {
          var isLight = root.getAttribute('data-theme') === 'light';
          var label = isLight ? btn.dataset.labelDark : btn.dataset.labelLight;
          btn.setAttribute('aria-pressed', isLight ? 'true' : 'false');
          btn.setAttribute('aria-label', label);
          btn.setAttribute('title', label);
        }

        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('site-theme', next); } catch (e) {}
          sync();
        });

        // While following the OS, react to the OS switching theme mid-session —
        // but never override a theme the visitor picked explicitly.
        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var onOsChange = function (e) {
            var chosen = null;
            try { chosen = localStorage.getItem('site-theme'); } catch (err) {}
            if (chosen === 'light' || chosen === 'dark') return;
            root.setAttribute('data-theme', e.matches ? 'dark' : 'light');
            sync();
          };
          if (mq.addEventListener) mq.addEventListener('change', onOsChange);
          else if (mq.addListener) mq.addListener(onOsChange);
        }

        sync();
      })();
    </script>
  </body>
</html>
