---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import zh from '../../i18n/zh.json';
const projects = (await getCollection('projects', ({ data }) => data.lang === 'zh')).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout locale="zh" path="projects" title={zh.projects.title} description={zh.projects.intro}><div class="page-header"><div class="eyebrow">~/projects</div><h1>{zh.projects.title}</h1><p>{zh.projects.intro}</p></div><div class="grid">{projects.map((project) => <ProjectCard project={project} locale="zh" />)}</div></BaseLayout>
