---
import BaseLayout from '../../layouts/BaseLayout.astro';
import zh from '../../i18n/zh.json';
import { resume } from '../../data/resume';
import { withBase } from '../../data/site';
const data = resume.zh;
---
<BaseLayout locale="zh" path="about" title={zh.about.title} description={zh.about.intro}><div class="page-header"><div class="eyebrow">~/about</div><h1>{zh.about.title}</h1><p>{zh.about.intro}</p></div><div class="resume-grid"><aside class="resume-aside"><h2>{data.name}</h2><p>{data.headline}</p><h3>{zh.about.contact}</h3><p><a href={`mailto:${data.contact}`}>{data.contact}</a></p><p><a class="inline-link" href={data.linkedin} target="_blank" rel="noreferrer">{data.linkedin}</a></p><p>{zh.about.city}</p><a class="button" href={withBase('resume/戎菲菲-Resume-AI工程师-一页版-v3.pdf')} download>{zh.about.download}</a></aside><div><section class="resume-section"><h2>{zh.about.summary}</h2>{data.summary.map((item) => <p>{item}</p>)}</section><section class="resume-section"><h2>{zh.about.skills}</h2>{data.skills.map(([label, detail]) => <p><strong>{label}</strong><br />{detail}</p>)}</section><section class="resume-section"><h2>{zh.about.experience}</h2>{data.experience.map((job) => <div class="resume-job"><h3>{job.company}</h3><p class="resume-period">{job.role} {job.period && `· ${job.period}`}</p><ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div>)}</section><section class="resume-section"><h2>{zh.about.education}</h2><ul>{data.education.map((item) => <li>{item}</li>)}</ul></section></div></div></BaseLayout>
