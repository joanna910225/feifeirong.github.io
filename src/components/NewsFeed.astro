---
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';
interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const ui = locale === 'zh' ? zh : en;
const publicDir = path.join(process.cwd(), 'public');
let feed: { files?: string[] } = {};
try { feed = JSON.parse(fs.readFileSync(path.join(publicDir, 'index.json'), 'utf8')); } catch {}
const news = (feed.files ?? []).slice(0, 12).map((file) => {
  try {
    const data = JSON.parse(fs.readFileSync(path.join(publicDir, 'news', file), 'utf8'));
    const rawDate = data.timestamp?.slice(0, 10) ?? file.match(/\d{4}-\d{2}-\d{2}/)?.[0];
    const summary = locale === 'zh' ? (data.summary_zh ?? data.summary ?? data.summary_en ?? '') : (data.summary_en ?? data.summary ?? '');
    return { file, date: rawDate ? new Date(rawDate) : new Date(), timestamp: data.timestamp, summary, citations: data.citations ?? [], html: marked.parse(summary) as string };
  } catch { return null; }
}).filter((item): item is NonNullable<typeof item> => Boolean(item));
---
<div class="news-feed">
  {news.length === 0 ? <p class="muted">{ui.news.empty}</p> : news.map((item) => <details class="news-entry"><summary><span class="news-date">{item.timestamp ?? item.date.toISOString().slice(0, 10)}</span><span class="news-summary-title">{item.summary.split('\n')[0].replace(/[*#]/g, '').slice(0, 90)}</span><span class="chevron">+</span></summary><div class="news-content" set:html={item.html}></div>{item.citations.length > 0 && <div class="citations">{item.citations.map((url: string) => <a href={url} target="_blank" rel="noreferrer">source ↗</a>)}</div>}</details>)}
</div>
