---
import type { CollectionEntry } from 'astro:content';
import en from '../i18n/en.json';
import zh from '../i18n/zh.json';
interface Props { project: CollectionEntry<'projects'>; locale: 'en' | 'zh'; }
const { project, locale } = Astro.props;
const ui = locale === 'zh' ? zh : en;
const statusLabel = project.data.status === 'concept'
  ? ui.projects.concept
  : ['active', 'in-progress'].includes(project.data.status ?? '')
    ? ui.projects.inProgress
    : project.data.currentEmployer
      ? ui.projects.current
      : ui.projects.personal;
---
<article class="project-card">
  <div class="card-kicker"><span>{statusLabel}</span><span>{project.data.period}</span></div>
  <h3>{project.data.title}</h3>
  <p class="card-meta">{project.data.role}</p>
  <p>{project.data.summary}</p>
  <div class="stack">{project.data.stack.slice(0, 4).map((item) => <span>{item}</span>)}</div>
  {project.data.url && <a class="text-link project-link" href={project.data.url} target="_blank" rel="noreferrer">GitHub ↗</a>}
</article>
